# ─── LLM provider ────────────────────────────────────────────────────────────
# Priority: a generic OpenAI-compatible endpoint (below) wins exclusively;
# otherwise the default is OpenRouter (if its key starts with sk-), then Ollama.
# Used by both scoring (scorer) and the Briefing + Ask AI (api).

# Option A — generic OpenAI-compatible endpoint (vLLM, llama.cpp, LM Studio,
# Groq, Together, OpenAI, …). Set LLM_BASE_URL to switch off OpenRouter/Ollama
# entirely and talk only to this endpoint. Leave blank to use Options B/C.
#   LLM_BASE_URL accepts a base (…/v1) or a full …/v1/chat/completions URL.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Option B — OpenRouter (recommended cloud accelerator) — leave blank for local only
OPENROUTER_API_KEY=
SCORER_MODEL=google/gemini-flash-1.5

# Option C — Ollama (fully local) — leave blank to use OpenRouter only
# macOS + Docker Desktop  → http://host.docker.internal:11434
# Linux                   → http://host-gateway:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral

# ─── App ──────────────────────────────────────────────────────────────────────
FETCH_INTERVAL_MINUTES=720
DB_PATH=/data/makhal.db

# Internal service-to-service secret — change this, never expose it
API_SECRET=changeme_local

# ─── Anti-flood guardrails ────────────────────────────────────────────────────
# Max new articles ingested per feed per poll cycle
MAX_NEW_ARTICLES_PER_FEED=5

# Ignore articles older than N days
MAX_ARTICLE_AGE_DAYS=7

# Delay (seconds) after each LLM scoring call, per concurrent slot (rate limiting)
SCORE_DELAY_SECONDS=2.0

# LLM scoring calls in flight at once. Keep 1 for a local Ollama. Cloud providers
# can take more within their rate limit (OpenRouter ":free" models: 20 req/min).
# A provider 429 pauses scoring and reschedules articles without burning an attempt.
SCORING_CONCURRENCY=1

# Seconds the scorer reuses the preference profile before rebuilding it (0 = every article)
PREFERENCE_CACHE_SECONDS=600

# ─── Retention ────────────────────────────────────────────────────────────────
# Max articles kept per feed — oldest read articles are pruned first
MAX_ARTICLES_PER_FEED=200

# Hard-delete articles older than N days (0 = disabled)
ARTICLE_RETENTION_DAYS=90

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED if the app is reachable from the internet

# Set to false for local HTTP development, true (default) for production HTTPS
HTTPS_ONLY=true

# Generate a strong password — example: openssl rand -base64 32
AUTH_PASSWORD=change_me_to_a_strong_password

# CORS origin — must match your public domain exactly (no trailing slash)
CORS_ORIGIN=https://reader.example.com

# Production runs behind Nginx Proxy Manager.
# NPM should forward to makhal-reader-web:80.
